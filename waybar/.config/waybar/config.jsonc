{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 0,
  "margin-top": 5,

  // Device-specific modules provided by GNU Stow host package
  "include": ["~/.config/waybar/host.jsonc"],

  // Left
  "modules-left": ["hyprland/workspaces"],

  "hyprland/workspaces": {
    "format": "{id}{windows}",
    "format-icons": {},
    "show-special": true,
    "format-window-separator": "",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<kitty> title<.*nvim .*>": " ",
      "title<.*YouTube.*>": " ",
      "class<yandex-music>": " ",
      "class<spotify>": " ",
      "class<kitty>": " ",
      "class<org.telegram.desktop>": " ",
      "class<discord>": " ",
      "class<obsidian>": " 󱚌",
      "class<zen>": " ",
      "class<TradingView>": " "
    }
  },

  // Center
  "modules-center": [
    "custom/temp",
    "custom/notification",
    "custom/pomodoro"
  ],

  "custom/temp": {
    "exec": "~/.config/waybar/scripts/haTemp.sh",
    "return-type": "json",
    "interval": 10,
    "format": " {}",
    "on-click": "~/.config/waybar/scripts/haopen.sh",
    "tooltip": false
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/pomodoro": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/waybar-module-pomodoro --work 90 -p  -a  -o 󰔛 -b  ",
    "on-click": "~/.config/waybar/scripts/waybar-module-pomodoro toggle",
    "on-click-right": "~/.config/waybar/scripts/waybar-module-pomodoro reset"
  },

  // Module Definitions (Shared by all machines)
  "custom/button": {
    "exec": "~/.config/waybar/scripts/monLight.sh",
    "on-click": "~/.config/waybar/scripts/monLight.sh --toggle && pkill -SIGRTMIN+8 waybar",
    "on-scroll-up": "~/.config/waybar/scripts/monLight.sh --brightness up && pkill -SIGRTMIN+8 waybar",
    "on-scroll-down": "~/.config/waybar/scripts/monLight.sh --brightness down && pkill -SIGRTMIN+8 waybar",
    "on-click-right": "~/.config/waybar/scripts/launch_temp_slider.sh",
    "return-type": "json",
    "format": "{}",
    "signal": 8
  },

  "tray": {
    "spacing": 10
  },

  "battery": {
    "bat": "BAT0",
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["", "", "", "", ""]
  },

  "network": {
    "interface": "wlan0",
    "format-wifi": " {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀  {ipaddr}/{cidr}",
    "tooltip-format": "{ifname} via {gwaddr}",
    "format-linked": "󰈀  {ifname} (No IP)",
    "format-disconnected": "⚠ Disconnected",
    "on-click-right": "kitty -e nmtui",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },

  "cpu": {
    "format": " {usage}%",
    "on-click": "kitty -e htop"
  },

  "memory": {
    "format": " {used:0.1f}Gb",
    "on-click": "kitty -e htop"
  },

  "pulseaudio": {
    "format": "{icon}{volume}",
    "format-icons": {
      "default": [" ", " ", " "]
    },
    "on-click": "pavucontrol"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%d.%m.%Y}",
    "tooltip": false,
    "interval": 10
  }
}



