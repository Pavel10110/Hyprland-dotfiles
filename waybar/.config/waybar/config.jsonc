{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 0,
  "margin-top": 5,
  "include": [
    "~/.config/waybar/host.jsonc"
  ],
  "modules-left": [
    "hyprland/workspaces"
  ],
  "hyprland/workspaces": {
    "show-special": true,
    "format-window-separator": "",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<kitty> title<.*nvim .*>": " ",
      "title<.*YouTube.*>": " ",
      "class<yandex-music>": " ",
      "class<spotify>": " ",
      "class<kitty>": " ",
      "class<org.telegram.desktop>": " ",
      "class<discord>": " ",
      "class<obsidian>": " 󱚌",
      "class<zen>": " ",
      "class<TradingView>": " "
    }
  },
  "modules-center": [
    "custom/temp",
    "custom/notification",
    "custom/pomodoro"
  ],
  "custom/temp": {
    "exec": "python3 ~/.config/waybar/scripts/ha_runtime.py temp",
    "return-type": "json",
    "interval": 10,
    "format": " {}",
    "on-click": "python3 ~/.config/waybar/scripts/ha_runtime.py open",
    "tooltip": false
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/pomodoro": {
    "format": "{}",
    "return-type": "json",
    "exec": "python3 ~/.config/waybar/scripts/pomodoro_runtime.py --work 90 -p  -a  -o 󰔛 -b  ",
    "on-click": "python3 ~/.config/waybar/scripts/pomodoro_runtime.py toggle",
    "on-click-right": "python3 ~/.config/waybar/scripts/pomodoro_runtime.py reset"
  },
  "custom/button": {
    "exec": "python3 ~/.config/waybar/scripts/ha_runtime.py light",
    "on-click": "python3 ~/.config/waybar/scripts/ha_runtime.py light --toggle && pkill -SIGRTMIN+8 waybar",
    "on-scroll-up": "python3 ~/.config/waybar/scripts/ha_runtime.py light --brightness up && pkill -SIGRTMIN+8 waybar",
    "on-scroll-down": "python3 ~/.config/waybar/scripts/ha_runtime.py light --brightness down && pkill -SIGRTMIN+8 waybar",
    "on-click-right": "python3 ~/.config/waybar/scripts/ha_runtime.py slider",
    "return-type": "json",
    "format": "{}",
    "signal": 8
  },
  "tray": {
    "spacing": 10
  },
  "battery": {
    "bat": "BAT0",
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "network": {
    "format-ethernet": "󰈀  {ipaddr}/{cidr}",
    "tooltip-format": "{ifname} via {gwaddr}",
    "format-linked": "󰈀  {ifname} (No IP)",
    "format-disconnected": "⚠ Disconnected",
    "on-click-right": "kitty -e nmtui",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },
  "custom/keyboard-battery": {
    "exec": "python3 ~/.config/waybar/scripts/peripheral_battery.py keyboard",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "tooltip": true
  },
  "custom/jbl-battery": {
    "exec": "python3 ~/.config/waybar/scripts/peripheral_battery.py jbl",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "tooltip": true
  },
  "cpu": {
    "format": " {usage}%",
    "on-click": "kitty -e htop"
  },
  "memory": {
    "format": " {used:0.1f}Gb",
    "on-click": "kitty -e htop"
  },
  "pulseaudio": {
    "format": "{icon}{volume}",
    "format-icons": {
      "default": [
        " ",
        " ",
        " "
      ]
    },
    "on-click": "pavucontrol"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%d.%m.%Y}",
    "tooltip": false,
    "interval": 10
  }
}
