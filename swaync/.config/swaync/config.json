{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "cssPriority": "application",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 16,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "notification-2d-margin": true,
  "control-center-width": 380,
  "fit-to-screen": true,

  "widgets": [
    "buttons-grid",
    "mpris",
    "title",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "󰂚  Notifications",
      "clear-all-button": true,
      "button-text": "󰎟  Clear"
    },
    "dnd": {
      "text": "󰂛  Do Not Disturb"
    },
    "mpris": {
      "image-size": 76,
      "image-radius": 12
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰂛",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d",
          "update-command": "swaync-client -D"
        },
        {
          "label": "󰌾",
          "command": "hyprlock"
        },
        {
          "label": "󰤄",
          "command": "systemctl suspend"
        }
      ]
    }
  }
}
